<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcademicClaimsPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcademicClaimsPortal.styles.css" asp-append-version="true" />
    <!-- Add Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-university"></i> AcademicClaimsPortal
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Home
                            </a>
                        </li>

                        <!-- ROLE INDICATOR -->
                        @{
                            var selectedRole = TempData["SelectedRole"] as string;
                        }
                        @if (!string.IsNullOrEmpty(selectedRole))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning fw-bold">
                                    <i class="fas fa-user-tag me-1"></i>
                                    @selectedRole.ToUpper()
                                </span>
                            </li>
                        }
                    </ul>

                    <!-- Quick Action Buttons -->
                    <div class="navbar-nav">
                        @if (!string.IsNullOrEmpty(selectedRole))
                        {
                            @if (selectedRole == "lecturer")
                            {
                                <a class="nav-link text-dark" asp-controller="Claim" asp-action="Create">
                                    <i class="fas fa-plus-circle"></i> Submit Claim
                                </a>
                                <a class="nav-link text-dark" asp-controller="Claim" asp-action="TrackStatus">
                                    <i class="fas fa-search"></i> Track Status
                                </a>
                            }
                            else if (selectedRole == "coordinator")
                            {
                                <a class="nav-link text-dark" asp-controller="Coordinator" asp-action="PendingClaims">
                                    <i class="fas fa-tasks"></i> Review Claims
                                </a>
                                <a class="nav-link text-dark" asp-controller="Coordinator" asp-action="CheckDocuments">
                                    <i class="fas fa-file-alt"></i> Check Documents
                                </a>
                            }
                            else if (selectedRole == "hr")
                            {
                                <a class="nav-link text-dark" asp-controller="HR" asp-action="Dashboard">
                                    <i class="fas fa-chart-bar"></i> Dashboard
                                </a>
                                <a class="nav-link text-dark" asp-controller="HR" asp-action="GenerateReport">
                                    <i class="fas fa-chart-pie"></i> Reports
                                </a>
                            }
                        }

                        <!-- Always show these links -->
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">
                            <i class="fas fa-shield-alt"></i> Privacy
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AcademicClaimsPortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>