@{
    ViewData["Title"] = "Track Claim Status";
}

<h2>Track Claim Status</h2>

<form asp-action="TrackStatus" method="post" id="trackStatusForm">
    <div class="form-group">
        <label for="claimReference">Enter Claim Reference:</label>
        <input type="text" name="claimReference" id="claimReference" class="form-control"
               placeholder="e.g., CLM-20241117153000" required
               list="claimReferences" autocomplete="off" />
        <datalist id="claimReferences">
            <!-- Claim references will be populated by JavaScript -->
        </datalist>
        <small class="form-text text-muted">Start typing or select from the dropdown</small>
    </div>

    <button type="submit" class="btn btn-primary mt-3">
        <i class="fas fa-search"></i> Track Status
    </button>
</form>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.ErrorMessage
    </div>
}

<!-- Recent Claims Section -->
<div class="mt-4">
    <h4>Recent Claims</h4>
    <div id="recentClaims" class="list-group">
        <!-- Recent claims will be loaded here -->
    </div>
</div>

<div class="mt-4">
    <a href="/Claim/Create" class="btn btn-outline-secondary">
        <i class="fas fa-plus"></i> Submit New Claim
    </a>
    <a href="/Home/Index" class="btn btn-outline-dark">
        <i class="fas fa-home"></i> Back to Home
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load all claim references for autocomplete
            loadClaimReferences();

            // Load recent claims
            loadRecentClaims();

            function loadClaimReferences() {
                $.get('/Claim/GetAllClaimReferences', function(data) {
                    var datalist = $('#claimReferences');
                    datalist.empty();

                    data.forEach(function(claimRef) {
                        datalist.append('<option value="' + claimRef + '">');
                    });
                });
            }

            function loadRecentClaims() {
                $.get('/Claim/GetRecentClaims', function(data) {
                    var container = $('#recentClaims');
                    container.empty();

                    if (data.length === 0) {
                        container.append('<div class="list-group-item text-muted">No recent claims found.</div>');
                        return;
                    }

                    data.forEach(function(claim) {
                        var badgeClass = getStatusBadgeClass(claim.status);
                        var listItem = `
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">${claim.claimReference}</h6>
                                    <small class="text-muted">${formatDate(claim.submissionDate)}</small>
                                </div>
                                <p class="mb-1">${claim.lecturerName} - ${claim.department}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small>R ${claim.totalAmount.toFixed(2)}</small>
                                    <span class="badge ${badgeClass}">${claim.status}</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                        onclick="selectClaimReference('${claim.claimReference}')">
                                    <i class="fas fa-search"></i> Track This Claim
                                </button>
                            </div>
                        `;
                        container.append(listItem);
                    });
                });
            }

            function getStatusBadgeClass(status) {
                if (status.includes('Approved')) return 'bg-success';
                if (status.includes('Rejected')) return 'bg-danger';
                if (status === 'Pending') return 'bg-warning';
                return 'bg-secondary';
            }

            function formatDate(dateString) {
                var date = new Date(dateString);
                return date.toLocaleDateString();
            }
        });

        // Function to auto-fill the search box when clicking "Track This Claim"
        function selectClaimReference(claimRef) {
            $('#claimReference').val(claimRef);
            $('#trackStatusForm').submit();
        }
    </script>
}