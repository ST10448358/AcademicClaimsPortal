@model AcademicClaimsPortal.Models.Claim

@{
    ViewData["Title"] = "Claim Status Details";
}

<h2>Claim Status Details</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Claim Reference: @Model.ClaimReference</h4>

        <div class="row mt-3">
            <div class="col-md-6">
                <strong>Lecturer:</strong> @Model.LecturerName<br>
                <strong>Department:</strong> @Model.Department<br>
                <strong>Period:</strong> @Model.Month @Model.Year<br>
            </div>
            <div class="col-md-6">
                <strong>Hours:</strong> @Model.HoursWorked<br>
                <strong>Rate:</strong> R @Model.HourlyRate<br>
                <strong>Total:</strong> R @Model.TotalAmount<br>
            </div>
        </div>

        <div class="mt-3">
            <strong>Status:</strong>
            <span class="badge @(Model.Status.Contains("Approved") ? "bg-success" :
                                                 Model.Status.Contains("Rejected") ? "bg-danger" : "bg-warning")">
                @Model.Status
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ReviewedBy))
        {
            <div class="mt-2">
                <strong>Reviewed By:</strong> @Model.ReviewedBy<br>
                <strong>Review Date:</strong> @Model.ReviewDate?.ToString("yyyy-MM-dd")
            </div>
        }

        <div class="mt-4">
            <a href="/Claim/TrackStatus" class="btn btn-secondary">Check Another Claim</a>
            <a href="/Claim/Create" class="btn btn-primary">Submit New Claim</a>
            <a href="/Home/Index" class="btn btn-outline-dark">Back to Home</a>
        </div>
    </div>
</div>

<div class="mt-4">
    <a href="/Home/Index" class="btn btn-outline-dark">
        <i class="fas fa-home"></i> Back to Home
    </a>
</div>